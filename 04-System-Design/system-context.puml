@startuml
title Aveli — System Context

skinparam shadowing false
skinparam roundcorner 16
skinparam defaultTextAlignment center
skinparam ArrowColor #6E7781
skinparam ArrowThickness 1.2

skinparam rectangle {
  BackgroundColor white
  BorderColor #30363D
  FontColor #0D1117
}

actor "Beauty Professional" as USER

rectangle "Aveli Mobile App" as APP
rectangle "Local SQLite\nPer-user workspace data" as SQLITE
rectangle "Local File Storage\nVisit photos" as FILES
rectangle "Device Services\nContacts · Notifications · Secure Storage" as DEVICE

rectangle "Aveli Backend API\nNestJS" as API
rectangle "PostgreSQL\nAccount · Session · Access · Subscription" as PG

rectangle "RevenueCat" as RC
rectangle "Google Play /\nApp Store" as STORE
rectangle "Exchange Rate API" as FX

USER --> APP : daily work

APP --> SQLITE : read / write\nworkspace data
APP --> FILES : store / load\nvisit photos
APP --> DEVICE : contacts\nnotifications\ntokens / access snapshot

APP --> API : HTTPS\nAuth · Access · Billing
API --> PG : account and\nentitlement data

APP --> RC : purchase / restore\ncustomer state
RC --> API : webhook / billing state
RC --> STORE : subscription lifecycle

APP --> FX : exchange rates

note right of SQLITE
Clients
Appointments
Services
Payments
Notes
Schedule
Settings
end note

note right of PG
Users
Sessions
Access grants
Subscriptions
end note

note bottom of APP
Operational work data
does not synchronize
with the backend.
end note

@enduml