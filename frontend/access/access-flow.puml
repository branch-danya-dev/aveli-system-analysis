@startuml
title Aveli — Frontend Access Flow

start
:Hydrate secure access snapshot;

if (Network hint available?) then (yes)
  :GET /v1/access;
  if (Server access fetch succeeds?) then (yes)
    :Use server AccessState;
    :Persist verified snapshot;
  else (no)
    :Evaluate cached snapshot;
  endif
else (no)
  :Evaluate cached snapshot;
endif

if (Usable access state exists?) then (no)
  :needsNetwork;
  :Access Gate;
  stop
endif

if (hasAccess == false?) then (yes)
  :blocked;
  :Access Gate;
  stop
endif

if (Verification policy accepts state?) then (yes)
  :allowed;
  :Workspace;
else (no)
  :needsNetwork;
  :Access Gate;
endif

stop
@enduml
